{
  "name": "deploy-test-elysia",
  "version": "1.0.0",
  "description": "Elysia on Bun taskboard: typed validation, bun:sqlite persistence, validated CRUD/search/filter, health/readiness.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bash scripts/build.sh",
    "start": "bun dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bash scripts/smoke.sh",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}